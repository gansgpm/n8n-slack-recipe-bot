    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "   const recipe = $('Edit Fields').item.json.recipe;\n   let ai = ($json.text || '').trim();\n\n   if (ai.toUpperCase().startsWith('UNCLEAR')) {\n     return { json: { slackText: `🤔 I couldn't recognise \"${recipe}\" as a recipe. Could you rephrase it? (e.g. *Paneer Butter Masala*)` } };\n   }\n\n   ai = ai\n     .replace(/^#+\\s*(.+)$/gm, '*$1*')\n     .replace(/\\*\\*(.+?)\\*\\*/g, '*$1*')\n     .replace(/^\\s*[-*•]\\s+/gm, '• ');\n\n   return { json: { slackText: `🍳 *To make ${recipe}, you'll need:*\\n\\n${ai}` } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
