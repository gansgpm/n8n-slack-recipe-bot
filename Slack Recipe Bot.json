    {
      "parameters": {
        "promptType": "define",
        "text": "=   You are a helpful kitchen assistant.\n   List all the products and ingredients needed to make {{ $json.recipe }}.\n   - Return only a bulleted list (\"- \") with approximate quantities for 2–3 servings.\n   - Group similar items (e.g. whole spices) on one line where sensible.\n   - Keep it short and practical: no cooking steps, no introduction.\n   - If \"{{ $json.recipe }}\" is not a recognisable dish or recipe, reply with exactly: UNCLEAR",
        "batching": {}
      },
